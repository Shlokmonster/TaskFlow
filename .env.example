# ---------------------------------------------------------------------------
# TaskFlow — environment template.  Copy to `.env` and fill in real values.
# Never commit `.env`.  Only REQUIRED vars must be set to boot the server.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | production | test
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# --- Database (REQUIRED) ---------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow

# --- Auth (REQUIRED) -------------------------------------------------------
# Must be at least 16 characters. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-16-chars
JWT_EXPIRES_IN=7d
JWT_ISSUER=taskflow
JWT_AUDIENCE=taskflow-api
# bcrypt cost factor. 12 recommended in production, 4-6 keeps tests fast.
BCRYPT_SALT_ROUNDS=12

# --- HTTP / security (optional) -------------------------------------------
# Comma separated list of allowed origins, or * for any origin.
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
JSON_BODY_LIMIT=1mb

# --- Logging (optional) ----------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info

# --- Firebase Admin (OPTIONAL) ---------------------------------------------
# Leave blank to run without push notifications / Firebase login.
# The server logs a warning and keeps working — it never crashes.
#
# Option A: paste the service-account JSON fields directly.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes — they are converted to real newlines at load time.
FIREBASE_PRIVATE_KEY=

# Option B (takes precedence): path to a service-account JSON file.
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Tests (optional) ------------------------------------------------------
# Set to 0 to skip the automatic mongodb-memory-server download
USE_IN_MEMORY_DB=1
