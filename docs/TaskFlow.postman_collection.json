    {
      "name": "Teams",
      "item": [
        {
          "name": "List teams",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/teams?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["api", "teams"] }
          },
          "event": [
            {
              "listen": "test",
