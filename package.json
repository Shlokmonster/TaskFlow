{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "TaskFlow — production-quality task management backend with REST API, RBAC, real-time Socket.io and Firebase push notifications.",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "keywords": [
    "task-management",
    "express",
    "mongodb",
    "mongoose",
    "socket.io",
    "firebase",
    "jwt",
    "rbac"
  ],
  "license": "MIT",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js",
